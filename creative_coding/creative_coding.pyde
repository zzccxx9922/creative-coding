# Interactive Galaxy 

import subprocess
# Start the Mac audio player without freezing the animation

# PART 1 - BASIC SETTINGS
# This section controls the number of stars, the mouse interaction area
# and the colours that can be randomly given to each star
STAR_COUNT = 60
MOUSE_RADIUS = 120

PALETTE = [
    (80, 210, 255),    # cyan
    (155, 115, 255),   # purple
    (255, 245, 220)    # warm white
]


# PART 2 - STAR STORAGE
# This empty list will store every Star object created by the program
# Keeping all stars in one list makes it possible to update and draw them
stars = []
music_process = None

# PART 3 - PROGRAM SETUP
# setup() runs once when the sketch starts. It creates the canvas
# smooths the shapes and generates the first group of random stars
def setup():
    size(1000, 700)
    smooth()

    for i in range(STAR_COUNT):
        #Create a star and add it to the list using append()
        stars.append(Star())
        
    start_music()
# PART 4 - MAIN DRAWING LOOP
# draw() repeats many times every second. It redraws the background
# updates the position of every star and displays the current composition
# The "def" defines a function
def draw():
    # poll() returns 0 when the music has finished successfully
    # Start it again to keep the background music playing
    if music_process is not None and music_process.poll() == 0:
        start_music()
    
    background(4, 7, 24)

    draw_galaxy()

    for star in stars:
        star.update()
        star.display()

    draw_mouse_area()
    draw_title()
    draw_instructions()


# PART 5 - GALAXY SHAPE
# This function uses two ellipse outlines and one bright centre point
# to make the moving star field look more like a galaxy
def draw_galaxy():
    noFill()
    strokeWeight(1)
    #"55"is the transparency level
    stroke(80, 170, 255, 55)
    #"width" is the x-coordinate of the center
    #"height" is the ordinate of the center
    ellipse(width / 2, height / 2, 560, 220)
    ellipse(width / 2, height / 2, 330, 120)

    noStroke()
    fill(80, 130, 255, 40)
    ellipse(width / 2, height / 2, 90, 90)
    fill(230, 247, 255)
    ellipse(width / 2, height / 2, 12, 12)


# PART 6 - MOUSE INTERACTION GUIDE
# This circle shows the area where the mouse can affect nearby stars
# The real pushing calculation is inside the Star.update() method
def draw_mouse_area():
    noFill()
    stroke(80, 210, 255, 45)
    strokeWeight(1)
    ellipse(mouseX, mouseY, MOUSE_RADIUS * 2, MOUSE_RADIUS * 2)


# PART 7 - PROJECT TITLE
# This function places the artwork title in the upper-left corner
def draw_title():
    noStroke()
    fill(220, 235, 255)
    textSize(15)
    text("Interactive Galaxy", 28, 38)


# PART 8 - CLICK INTERACTION
# mousePressed() runs whenever the viewer clicks the canvas
# Each click creates six new stars at the mouse position
def mousePressed():
    for i in range(6):
        stars.append(Star(mouseX, mouseY, True))
        #Newly formed stars can continue to move and be displayed on the screen
    play_star_sound()


# PART 9 - STAR CLASS
# The Star class is a template for every star. It stores the position
# size, colour and speed of one individual star
class Star(object):

    # PART 9A - CREATE ONE STAR
    # __init__() gives a new star its starting position and random properties
    # Stars made by a click use a faster speed so they spread out visibly
    def __init__(self, x=None, y=None, fast=False):
        if x is None:
            x = random(width)
        if y is None:
            y = random(height)
#Stars are generated randomly when no horizontal and vertical coordinates are provided.
        self.x = x
        self.y = y
        #Stars are generated from the mouse position
        self.size = random(2, 6)
        #Randomly select the size of the star
        self.colour = PALETTE[int(random(len(PALETTE)))]
        #len(PALETTE) is represents the number of colors obtained
        #int is limit the that the selected number must be an integer
#Two_PI represents a complete 360-degree circle
        angle = random(TWO_PI)

        if fast:
            speed = random(1.2, 2.4)
            #This for the new star generated by mouse clicks
        else:
            speed = random(0.3, 0.9)
            #This for a regular star generated when the program starts
#cos and sin calculate which direction the star should move based on a random angle
        self.speed_x = cos(angle) * speed
        self.speed_y = sin(angle) * speed

    # PART 9B - MOVE ONE STAR
    # update() calculates the mouse push, adds speed to the star position
    # and makes stars return from the opposite edge of the canvas
    def update(self):
        dx = self.x - mouseX
        dy = self.y - mouseY
        #This uses the Pythagorean theorem to calculate the straight-line distance between the star and the mouse
        distance_to_mouse = sqrt(dx * dx + dy * dy)

        if distance_to_mouse > 0 and distance_to_mouse < MOUSE_RADIUS:
            push = 0.035
            self.speed_x += (dx / distance_to_mouse) * push
            self.speed_y += (dy / distance_to_mouse) * push
#update the position of the stars
        self.x += self.speed_x
        self.y += self.speed_y
#when a star leaves the left side, it will reappear on the right side; when it leaves the right side, it will reappear on the left side
        if self.x < 0:
            self.x = width
        elif self.x > width:
            self.x = 0
#stars appear from below after leaving the top, and appear from above after leaving the bottom
        if self.y < 0:
            self.y = height
        elif self.y > height:
            self.y = 0

    # PART 9C - DRAW ONE STAR
    # display() uses the star's stored colour, size and position
    # to draw it as a small circle on the canvas.
    def display(self):
        red, green, blue = self.colour
        noStroke()
        fill(red, green, blue)
        ellipse(self.x, self.y, self.size, self.size)
        
# PART 10 - AUDIO

# Start the background music or start it again after it finishes
def start_music():
    # Let this function update the music_process used in draw()
    global music_process
    # Find the music file in this sketch's data folder
    music_path = sketchPath("data/galaxy-background.wav")
    # afplay is the Mac audio player. Popen starts it without pausing the stars
    # 0.45 sets the background music volume
    music_process = subprocess.Popen(
        ["/usr/bin/afplay", "-v", "0.45", music_path]
    )

# Play one randomly selected sound for each mouse click.
def play_star_sound():
    # Store the filenames of the three click sounds.
    sound_files = [
        "star-click.wav",
        "star-bubble.wav",
        "star-laser.wav"
    ]

    # Randomly choose an index: 0, 1 or 2.
    sound_index = int(random(len(sound_files)))

    # Get the filename at the selected index.
    sound_name = sound_files[sound_index]

    # Find the selected sound in the data folder.
    sound_path = sketchPath("data/" + sound_name)

    # Play the selected sound without pausing the animation.
    subprocess.Popen(
        ["/usr/bin/afplay", "-v", "0.75", sound_path]
    )
# PART 11 - RESET THE GALAXY

# Processing calls this function when a key is pressed.
def keyPressed():
    # Both lowercase r and uppercase R reset the stars.
    if key == 'r' or key == 'R':
        reset_galaxy()


# Remove all current stars and create a fresh group.
def reset_galaxy():
    global stars
     # Replace the current stars with an empty list
    stars = []
    # Repeat STAR_COUNT times to restore the original number of stars
    for i in range(STAR_COUNT):
        # Create one star with random properties and add it to the list
        stars.append(Star())


# PART 12 - INTERACTION INSTRUCTIONS

# Show the controls at the bottom-left of the canvas.
def draw_instructions():
    noStroke()
    fill(170, 195, 220)
    textSize(12)
    text(
        "Move mouse: push stars  |  Click: add stars  |  R: reset",
        28,
        height - 24
    )
